package components

templ Title2CSS() {
	<style>
        .title2 {
            color: var(--color-black);
            font-size: 50px;
            font-weight: 700;
            margin-bottom: 40px;
            margin-top: 0;
        }
        .title2_center {
            text-align: center;
        }
    </style>
}

templ Title2(title string, isCenter bool) {
	@Title2CSS()
	<h1
		class={ "title2",
        templ.KV("title2_center", isCenter) }
	>{ title }</h1>
}
